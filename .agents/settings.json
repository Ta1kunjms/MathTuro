{
  "$schema": "https://antigravity.google/schemas/settings.json",
  "permissions": {
    "deny": [
      "read_file(./.env)",
      "read_file(./.env.local)",
      "read_file(./.env.production)",
      "read_file(./.env.development.local)",
      "read_file(./.env.production.local)",
      "read_file(./.env.test.local)",
      "read_file(./secrets/*)",
      "read_file(./credentials/*)",
      "command(git push*)",
      "command(git reset --hard*)",
      "command(git clean*)",
      "command(rm -rf*)",
      "command(Remove-Item * -Recurse*)",
      "command(*Remove-Item*-Recurse*)",
      "command(supabase db reset*)",
      "command(supabase db push*)",
      "command(vercel --prod*)",
      "command(npx vercel --prod*)"
    ]
  }
}
