# Supabase Configuration
# Replace these with your actual Supabase project credentials.
# The anon key is safe to expose in client-side apps with Row-Level Security (RLS) enabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# Next.js/Vite Compatibility
# Provided for compatibility if the project is migrated or integrated with a modern bundler in the future.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Settings
APP_NAME="Learning Management System"
APP_VERSION=1.0.0

# Local Server Settings
PORT=3000
